{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "fmt:mode",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/lib/fmt_hook.py", "expand"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
